# Copy to .env and fill in. Never commit .env.

# --- Auth -----------------------------------------------------------------------
# "clerk" in production. "dev" also accepts an X-User-Id header (local testing only).
AUTH_MODE=dev
# Clerk: either the PEM public key (Dashboard > API keys > JWKS Public Key) ...
CLERK_JWT_KEY=
# ... or the JWKS URL: https://<your-frontend-api>/.well-known/jwks.json
CLERK_JWKS_URL=
# Web app origins allowed to use session tokens (Clerk "azp"), comma separated.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Origins allowed to call the gateway from a browser (the web app).
CORS_ORIGINS=http://localhost:5173

# --- Keys -------------------------------------------------------------------------
# Encrypts users' API keys. Generate with: python -m opensession.keystore genkey
KEYSTORE_MASTER_KEYS=

# --- Sandboxes --------------------------------------------------------------------
SANDBOX_IMAGE=opencode-sandbox:latest
SANDBOX_MAX_RUNNING=10
SANDBOX_IDLE_SECONDS=1800
SANDBOX_MEM_LIMIT=2g
SANDBOX_CPUS=1.0
# SANDBOX_RUNTIME=runsc        # gVisor (Linux hosts only)

# Host port for docker compose (8000 is often taken)
GATEWAY_HOST_PORT=8787

# Optional: real Claude key for scripts/check/run-e2e.bat (runs one real agent test)
E2E_ANTHROPIC_API_KEY=
