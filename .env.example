# Copy to .env and fill in. Never commit .env.
# This template is set up for running locally. For a server, follow
# docs/DEPLOY-dokploy.md: the gateway refuses to start a public deployment with
# AUTH_MODE=dev, no KEYSTORE_MASTER_KEYS or the example database password.

# --- Auth -----------------------------------------------------------------------
# Sign-in is our self-hosted Better Auth server (services/auth). The gateway checks
# the JWTs it issues. "betterauth" in production; "dev" also accepts an X-User-Id
# header (local testing only).
AUTH_MODE=dev
# Public address of the auth server (web app signs in here). Also the JWT iss/aud.
BETTER_AUTH_URL=http://localhost:3001
# Signs sessions and encrypts the JWT signing keys: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Web app / desktop origins allowed to sign in, comma separated.
AUTH_TRUSTED_ORIGINS=http://localhost:3000,app://opensession
# 1 = no new accounts (existing ones still sign in).
# AUTH_DISABLE_SIGNUP=1
# Optional social sign-in (callback: <BETTER_AUTH_URL>/api/auth/callback/<provider>).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Gateway: where to fetch the auth server's public keys (docker compose sets this to
# the internal address), and what iss/aud to expect (= BETTER_AUTH_URL).
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks
AUTH_ISSUER=http://localhost:3001
AUTH_AUDIENCE=http://localhost:3001
# Origins allowed to call the gateway from a browser (the web app). Add
# app://opensession so the desktop app's cloud mode can open terminals.
CORS_ORIGINS=http://localhost:5173,app://opensession
# The gateway's public address (links it hands out, e.g. previews), e.g.
# https://api.example.com. Empty = taken from each request.
GATEWAY_PUBLIC_URL=
# Browser card previews of a project's dev server. With a domain (wildcard DNS and
# TLS for *.<domain> pointing at the gateway), each preview gets its own origin, so
# apps with absolute paths (Vite dev) work. Empty = previews under <gateway>/preview/.
PREVIEW_DOMAIN=

# --- Database ---------------------------------------------------------------------
# docker compose runs Postgres and sets DATABASE_URL for the gateway; just pick a
# password. Elsewhere, DATABASE_URL=postgresql://user:pass@host:5432/opensession
# (unset = SQLite file OPENSESSION_DB, fine for one process and development).
POSTGRES_PASSWORD=change-me

# --- Keys -------------------------------------------------------------------------
# Encrypts users' API keys. Generate with: python -m opensession.keystore genkey
KEYSTORE_MASTER_KEYS=

# --- Sandboxes --------------------------------------------------------------------
# Where sandboxes run (docs/DESIGN-unified-runtime.md): docker or e2b.
SANDBOX_PROVIDER=docker
# --- e2b only (pip install -e "services/gateway[e2b]"; template: scripts/e2b/build_template.py)
# E2B_API_KEY=
# E2B_TEMPLATE=opensession-sandbox
# Derives each sandbox's OpenCode password. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
# SANDBOX_PASSWORD_SECRET=
# E2B applies the egress allowlist itself, so the gateway must be able to read it:
# EGRESS_GLOBAL_ALLOWLIST=services/egress/allowlist.txt
SANDBOX_IMAGE=opencode-sandbox:latest
SANDBOX_MAX_RUNNING=10
# Idle projects go to sleep after this long (files and sessions are kept).
SANDBOX_IDLE_SECONDS=1800
# Projects one user may have awake at once (0 = no limit); admins can override per user.
SANDBOX_MAX_PER_USER=2
# Disk per project in MB (code + session data; 0 = no limit).
SANDBOX_DISK_LIMIT_MB=0
# Better Auth user ids (comma separated) who can open the Admin page (observability,
# sandboxes, errors; /admin/metrics for Prometheus) and change users' limits.
ADMIN_USER_IDS=
# One JSON log line per gateway request (route, status, ms); 0 turns it off.
# LOG_REQUESTS=1
# LOG_LEVEL=INFO
# Rate limits per minute (docs/DEPLOY-dokploy.md); RATE_LIMITS=0 turns them off.
# RATE_LIMIT_DEFAULT=3000
# RATE_LIMIT_PROMPT=60
# Model calls go through the gateway, which adds the user's key (it never enters a
# sandbox) and limits each user (docs/DEPLOY-dokploy.md); 0 = no limit.
# MODEL_TOKENS_PER_DAY=50000000
# MODEL_REQUESTS_PER_MINUTE=120
# MODEL_MAX_CONCURRENT=8
# MODEL_PROXY=1
# OpenCode's own hosted models (free tier, no key): 1 lists them and lets every
# sandbox reach opencode.ai through the egress proxy. Off by default.
# ALLOW_OPENCODE_PROVIDER=0
SANDBOX_MEM_LIMIT=2g
SANDBOX_CPUS=1.0
# The agent's browser runs in its own container beside each awake sandbox, on the
# sandbox's network (same egress rules). "sandbox" runs it inside the sandbox instead.
# SANDBOX_BROWSER=container
# SANDBOX_BROWSER_MEM_LIMIT=1g
# SANDBOX_RUNTIME=runsc        # gVisor (Linux hosts only)

# Host port for docker compose (8000 is often taken)
GATEWAY_HOST_PORT=8787

# --- GitHub (optional) -------------------------------------------------------------
# A GitHub App lets users connect repositories to projects (README > GitHub).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The app's private key: paste with \n for newlines, or point to the .pem file.
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# Signs the connect link (any long random string; keep it stable across restarts).
GITHUB_STATE_SECRET=
# Where /github/callback sends the browser back to (the web app).
OPENSESSION_WEB_URL=http://localhost:3000

# Optional: real Claude key for scripts/check/run-e2e.bat (runs one real agent test)
E2E_ANTHROPIC_API_KEY=
