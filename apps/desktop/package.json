{
  "name": "@opensession/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "OpenSession desktop: run the coding agent on your own computer",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsup && vite build",
    "start": "electron .",
    "dev": "tsup && vite build && electron .",
    "dist": "tsup && vite build && electron-builder",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@opensession/api-client": "workspace:*",
    "@opensession/local-runner": "workspace:*",
    "@opensession/ui": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "dev.opensession.desktop",
    "productName": "OpenSession",
    "files": ["dist/**", "package.json"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
