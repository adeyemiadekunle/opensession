{
  "name": "@opensession/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "OpenSession desktop: run the coding agent on your own computer",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsup && vite build",
    "start": "electron .",
    "dev": "tsup && vite build && electron .",
    "dist": "tsup && vite build && electron-builder --publish never",
    "typecheck": "tsc -p . --noEmit",
    "release": "tsup && vite build && electron-builder --publish always"
  },
  "dependencies": {},
  "devDependencies": {
    "@opensession/api-client": "workspace:*",
    "@opensession/local-runner": "workspace:*",
    "@opensession/ui": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "dev.opensession.desktop",
    "productName": "OpenSession",
    "artifactName": "OpenSession-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "adeyemiadekunle",
        "repo": "opensession",
        "releaseType": "draft"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "OpenSession",
      "syncDesktopName": true
    },
    "executableName": "opensession"
  },
  "author": {
    "name": "OpenSession"
  },
  "homepage": "https://github.com/adeyemiadekunle/opensession",
  "desktopName": "opensession.desktop"
}
