{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "skills": ["/home/agent/.config/opencode/os-skills"],
  "commands": {
    "greet": { "description": "Say hello", "template": "Reply with exactly: HELLO $ARGUMENTS" }
  },
  "agents": {
    "reviewer2": { "description": "Reviews code", "mode": "subagent", "system": "Review only.",
      "permissions": [{ "action": "edit", "resource": "*", "effect": "deny" }] }
  },
  "permissions": [{ "action": "webfetch", "resource": "*", "effect": "deny" }],
  "mcp": { "servers": { "fs": { "type": "local", "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/workspace"] } } }
}
